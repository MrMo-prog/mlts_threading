fit_model = F)
stan_data = noFit$standata
# old model without threading:
fitted_old = stan("AR_Erweiterung2_missings_und_censoring.stan", data = stan_data,
pars = c("gammas", "sd_R", "bcorr"),
iter = iterations, chains = 2, cores = 2, seed = 1015)
