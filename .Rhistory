N = 200
TP =400
Q = 1
maxlag = 1
iterations = 1000
missings = 0.01
mod = mlts_model(q = Q, fix_inno_covs = F, inno_covs_dir = "pos", max_lag = maxlag)
simData = mlts_sim(mod, N = N, TP = TP, default = T, seed = 123)
censL_val <- which(simData$data$Y1, 0.05, na.rm = TRUE)
# censoring
censL_val <- which(simData$data$Y1, 0.05)
censL_val <- quantile(simData$data$Y1, 0.05, na.rm = TRUE)
censR_val <- quantile(simData$data$Y1, 0.05, na.rm = TRUE)
censL_rows <- which(simData$data$Y1 <= censL_val)
censR_rows <- which(simData$data$Y1 >= censR_val)
simData$data$Y1[censL_rows] <- censL_val
simData$data$Y1[censR_rows] <- censR_val
print(paste(length(censL_rows)))
print(paste(length(censR_rows)))
